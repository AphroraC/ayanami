{
  "navigation": {
    "behavior_tree_extension": "libayanami_navigation_behavior_tree.so",
    "so_name": "libayanami_costmap_navigation.so",
    "behavior_tree_id": "NavigateWithReplanningAndSmoothing",
    "behavior_tree_xml": "BT/costmap_navigation.xml",
    "config_planner": "modules/costmap_astar_planner.json",
    "config_smoother": "modules/costmap_minsnap_smoother.json",
    "config_controller": "modules/costmap_pid_controller.json",
    "config_goal_checker": "modules/simple_goal_checker.json",
    "config_progress_checker": "modules/simple_progress_checker.json",
    "config_recovery": [
      "modules/costmap_cleanup_recovery.json",
      "modules/costmap_spin_recovery.json",
      "modules/costmap_wait_recovery.json",
      "modules/costmap_back_up_recovery.json"
    ],
    "planner_frequency": -1.0,
    "smoother_frequency": 10.0,
    "controller_frequency": 50.0,
    "max_nav_retries": 6,
    "planner_timeout": 2.0,
    "smoother_timeout": 2.0,
    "max_same_cause": 3,
    "oscillation_distance": 0.1,
    "oscillation_timeout": 5.0,
    "controller_patience": 1.0,
    "recovery_patience": 0.0,
    "max_vel_x": 2.0,
    "max_vel_y": 2.0,
    "max_vel_theta": 2,
    "robot_frame": "base_link",
    "velocity_timeout": 0.25
  },
  "costmap": {
    "dump_frequency": 0.1,
    "global_costmap_frame": "map",
    "local_costmap_frame": "odom",
    "resolution": 0.05,
    "robot_radius": 0.3
  },
  "costmap_global": {
    "layers": [
      "static_layer",
      "inflation_layer"
    ],
    "rolling_window": false,
    "track_unknown": false,
    "static_layer": {
      "so_name": "libayanami_costmap_static_layer.so",
      "static_map": "config/assets/nav.pgm"
    },
    "inflation_layer": {
      "so_name": "libayanami_costmap_inflation_layer.so",
      "inflation_radius": 0.5,
      "inscribed_radius": 0.3,
      "cost_scaling_factor": 3.0
    }
  },
  "costmap_local": {
    "layers": [
      "obstacle_layer",
      "inflation_layer"
    ],
    "size_x": 120,
    "size_y": 120,
    "resolution": 0.05,
    "origin": [
      0.0,
      0.0,
      0.0
    ],
    "rolling_window": true,
    "track_unknown": false,
    "transform_tolerance": 0.1,
    "update_frequency": 50.0,
    "observation_keep_time": 0.5,
    "filter_static_marks": true,
    "obstacle_layer": {
      "so_name": "libayanami_costmap_obstacle_layer.so",
      "combination": "overwrite",
      "footprint_clearing": true,
      "decay_time": 1.0,
      "decay_sweep_interval": 0.2,
      "observation_sources": [
        "nagisa_obstacle"
      ],
      "nagisa_obstacle": {
        "type": "pointcloud",
        "marking": true,
        "clearing": true,
        "min_obstacle_height": 0.0,
        "max_obstacle_height": 1.0,
        "obstacle_min_range": 0.2,
        "obstacle_max_range": 3.0,
        "raytrace_min_range": 0.1,
        "raytrace_max_range": 3.5,
        "expected_update_rate": 1.0
      }
    },
    "inflation_layer": {
      "so_name": "libayanami_costmap_inflation_layer.so",
      "inflation_radius": 0.55,
      "inscribed_radius": 0.3,
      "cost_scaling_factor": 3.0
    }
  }
}
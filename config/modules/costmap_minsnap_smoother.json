{
  "smoother": {
    "name": "costmap_minsnap_smoother",
    "so_name": "libayanami_costmap_minsnap_smoother.so"
  },
  "costmap_minsnap_smoother": {
    "polynomial_order": 6,
    "derivative_order": 3,
    "max_speed": 3.0,
    "max_acc": 1.0,
    "max_corridor_range": 2.5,
    "corridor_shrink": 0.0,
    // Repair rounds: sparse pins make first-solve corner cuts deeper; more
    // rounds give the midpoint-insertion loop room to converge near
    // obstacles (measured: wp=20 + 8 rounds converges on a corner-adjacent
    // obstacle).
  "collision_iterations": 8,
    "normalized_time": true,
    "backend": "closed_form",
    // Waypoint cap = the number of PINNED interior points: the closed-form
    // backend hard-pins every kept waypoint, so each one is a corner the
    // min-jerk arc cannot round. Measured on an A*-style zigzag (input max
    // curvature 20): 40 pins -> 22.9 (WORSE than the raw path, the
    // continuity constraints oscillate between alternating corners);
    // 20 -> 6.0 with the collision-repair loop still converging near
    // obstacles; <=16 -> smoother still (down to 1.5 at 6) but the repair
    // loop exhausts and the smoother degrades to the raw path when the cut
    // hits an obstacle. 20 is the balance point; safety nets for a degraded
    // solve: IsPathValid + DegradeToRawPath (smoothing is an enhancement,
    // never a failure).
  "max_waypoints": 20
  }
}

{
  "ayanami_ros": {
    "pointcloud_topic": "/velodyne_points",
    "laserscan_topic": "",
    "odom_topic": "/odom",
    "goal_topic": "/move_base_simple/goal",
    "map_frame": "map",
    "odom_frame": "odom",
    "robot_frame": "base_link",
    "tf_sync_rate": 50.0,
    "tf_cache_duration": 10.0,
    "tf_sync_edges": [
      "map-odom:50hz",
      "odom-base_link:50hz",
      "base_link-laser:10hz"
    ],
    "tf_static_edges": [
      "base_link-laser"
    ],
    "localization_clear_yaw_threshold": 1.0,
    "localization_clear_pos_threshold": 2.0,
    "navigation_so_name": "libayanami_costmap_navigation.so"
  }
}

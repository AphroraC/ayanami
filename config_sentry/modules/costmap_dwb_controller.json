{
  "controller": {
    "name": "costmap_dwb_controller",
    "so_name": "libayanami_costmap_dwb_controller.so"
  },
  "costmap_dwb_controller": {
    "critics": [
      "Oscillation",
      "BaseObstacle",
      "PathDist",
      "GoalDist",
      "Twirling"
    ],
    "default_critic_namespaces": [
      "dwb_critics"
    ],
    "trajectory_generator_name": "dwb_plugins::StandardTrajectoryGenerator",
    "prune_plan": true,
    "prune_distance": 2.0,
    "forward_prune_distance": 2.0,
    "debug_trajectory_details": false,
    "transform_tolerance": 0.1,
    "shorten_transformed_plan": true,
    "short_circuit_trajectory_evaluation": true,
    "min_vel_x": -0.3,
    "min_vel_y": -0.5,
    "max_vel_x": 0.5,
    "max_vel_y": 0.5,
    "max_vel_theta": 0.8,
    "min_speed_xy": 0.0,
    "max_speed_xy": 0.5,
    "min_speed_theta": 0.0,
    "acc_lim_x": 1.0,
    "acc_lim_y": 1.0,
    "acc_lim_theta": 1.5,
    "decel_lim_x": -1.0,
    "decel_lim_y": -1.0,
    "decel_lim_theta": -1.5,
    "vx_samples": 20,
    "vy_samples": 10,
    "vtheta_samples": 20,
    "sim_time": 1.7,
    "discretize_by_time": false,
    "time_granularity": 0.5,
    "linear_granularity": 0.5,
    "angular_granularity": 0.025,
    "include_last_point": true,
    "limit_vel_cmd_in_traj": false,
    "xy_goal_tolerance": 0.25,
    "trans_stopped_velocity": 0.25,
    "Oscillation.scale": 1.0,
    "Oscillation.oscillation_reset_dist": 0.15,
    "Oscillation.oscillation_reset_angle": 1.0,
    "Oscillation.oscillation_reset_time": -1.0,
    "Oscillation.x_only_threshold": 0.05,
    "BaseObstacle.scale": 1.0,
    "BaseObstacle.sum_scores": false,
    "PathDist.scale": 32.0,
    "PathDist.aggregation_type": "last",
    "GoalDist.scale": 24.0,
    "GoalDist.aggregation_type": "last",
    "Twirling.scale": 5.0
  }
}

{
  "navigation": {
    "behavior_tree_extension": "libayanami_navigation_behavior_tree.so",
    "behavior_tree_id": "NavigateWithReplanningAndSmoothing",
    "config_planner": "modules/costmap_astar_planner.json",
    "config_smoother": "modules/costmap_savitzky_smoother.json",
    "config_controller": "modules/costmap_dwb_controller.json",
    "config_goal_checker": "modules/simple_goal_checker.json",
    "config_progress_checker": "modules/simple_progress_checker.json",
    "config_recovery": [
      "modules/costmap_clear_costmap_recovery.json",
      "modules/costmap_spin_recovery.json",
      "modules/costmap_wait_recovery.json",
      "modules/costmap_back_up_recovery.json"
    ],
    "planner_frequency": 1.0,
    "smoother_frequency": 10.0,
    "controller_frequency": 50.0,
    "max_nav_retries": 6,
    "oscillation_distance": 0.1,
    "oscillation_timeout": 5.0,
    "controller_patience": 1.0,
    "recovery_patience": 0.0,
    "max_vel_x": 2.5,
    "max_vel_y": 2.5,
    "max_vel_theta": 2.5,
    "robot_frame": "base_link",
    "velocity_timeout": 0.25,
    "costmap_visualization_rate": 1.0,
    "behavior_tree_xml": "BT/navigation.xml"
  },
  "costmap": {
    "global_costmap_frame": "map",
    "local_costmap_frame": "odom",
    "resolution": 0.05,
    "robot_radius": 0.3
  },
  "costmap_global": {
    "layers": [
      "modules/costmap_static_layer.json",
      "modules/costmap_obstacle_layer_global.json",
      "modules/costmap_inflation_layer_global.json"
    ],
    "rolling_window": false,
    "track_unknown": false
  },
  "costmap_local": {
    "layers": [
      "modules/costmap_obstacle_layer.json",
      "modules/costmap_inflation_layer.json"
    ],
    "size_x": 120,
    "size_y": 120,
    "resolution": 0.05,
    "origin": [
      0.0,
      0.0,
      0.0
    ],
    "rolling_window": true,
    "track_unknown": false,
    "transform_tolerance": 0.1,
    "update_frequency": 20.0,
    "visualization_rate": 5.0
  }
}
